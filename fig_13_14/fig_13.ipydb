    "sweep_rate = 10  # Hz/ms\n",
    "\n",
    "# Path to chirp template - used for finding chirp locations via cross-correlation\n",
    "template   = os.path.join('testing','n6-10Hztestsample.wav')\n",
    "\n",
    "data_dir   = os.path.join(base_dir,data_set)\n",
    "wavlist    = obtain_wav_list(data_dir)"
   ]
