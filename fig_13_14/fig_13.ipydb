  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Figure 13"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_TDOAs(chirps, TDOAs_sets = ['TDOAs'], set_names=None):\n",
    "    times = chirps['utc']\n",
    "    fig   = plt.figure(figsize=(16, 9))\n",
    "    ax    = fig.add_subplot(1, 1, 1)\n",
    "    \n",
    "    # for TDOAs, set_name in zip(TDOAs_sets, set_names):\n",
    "\n",
    "    for TDOAs_inx,TDOAs_set in enumerate(TDOAs_sets):\n",
    "        TDOAs = chirps[f'{TDOAs_set}_mean']\n",
    "        if set_names is None:\n",
    "            set_name = TDOAs_set\n",
    "        else:\n",
    "            set_name = set_names[TDOAs_inx]\n",
    "\n",
    "        ax.plot(times, TDOAs, marker = 'o',label=set_name)\n",
    "        \n",
    "        miny = 0\n",
    "        maxy = 3 #Originally 3\n",
    "        ax.set_ylim(miny, maxy)\n",
    "    \n",
    "    myFmt = mdates.DateFormatter('%H:%M')\n",
    "    ax.xaxis.set_major_formatter(myFmt)\n",
    "    ax.xaxis.set_major_locator(mdates.MinuteLocator(interval=15))\n",
    "\n",
    "    ax.set_ylabel('TDOA [ms]')\n",
    "    ax.set_xlabel('Time UTC')\n",
    "    ax.legend()\n",
    "\n",
    "    title = chirps.attrs.get('pfx','')\n",
    "    ax.set_title(title)\n",
    "    fig.autofmt_xdate()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    plt.close(fig)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x900 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plot_TDOAs(chirps,\n",
    "    TDOAs_sets = ['TDOAs',  'TDOAs_F', 'TDOAs_E'],\n",
    "    set_names  = ['2F2-1E', '1F2-2F2', '1F2-1E'],\n",
    ")"
   ]
